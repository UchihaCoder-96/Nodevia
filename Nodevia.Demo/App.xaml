<Application x:Class="Nodevia.Demo.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Nodevia.Demo"
             xmlns:converters="clr-namespace:Nodevia.Converters;assembly=Nodevia"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <local:PortResultConverter x:Key="PortResultConverter"/>

        <DataTemplate x:Key="NodeBody.display-result">
            <Border Background="#FF14141C" Margin="0,4,0,0" Padding="8,6" CornerRadius="4">
                <TextBlock
                FontSize="16"
                FontWeight="Bold"
                Foreground="#FF7CD9FF"
                HorizontalAlignment="Center">
                    <TextBlock.Text>
                        <MultiBinding Converter="{StaticResource PortResultConverter}">
                            <Binding Path="InputPorts[0].IsConnected"/>
                            <Binding Path="InputPorts[0].LiveDisplayValue"/>
                            <Binding Path="InputPorts[0].DefaultValue"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </Border>
        </DataTemplate>
        </Application.Resources>
</Application>
