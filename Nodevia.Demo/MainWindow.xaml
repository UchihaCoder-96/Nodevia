<Window
    x:Class="Nodevia.Demo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:nodevia="clr-namespace:Nodevia.Controls;assembly=Nodevia"
    Title="Nodevia Demo"
    Width="1000"
    Height="700">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <Menu
            Grid.Row="0"
            Padding="4,0">

            <MenuItem Header="_File">

                <MenuItem
                    Header="_New"
                    Click="New_Click"/>

                <MenuItem
                    Header="_Open..."
                    Click="Open_Click"/>

                <MenuItem
                    Header="_Save"
                    Click="Save_Click"/>

                <MenuItem
                    Header="Save _As..."
                    Click="SaveAs_Click"/>

                <Separator/>

                <MenuItem
                    Header="E_xit"
                    Click="Exit_Click"/>

            </MenuItem>

        </Menu>
        
        <nodevia:NodeCanvas
            x:Name="NodeCanvas"
            Grid.Row="1"
            Background="#FF070718"/>

    </Grid>

</Window>

