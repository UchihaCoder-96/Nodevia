<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Nodevia.Controls"
    xmlns:model="clr-namespace:Nodevia.Models">

    <!-- ============================================================
         NodeControl
         ============================================================ -->

    <Style TargetType="{x:Type local:NodeControl}">

        <Setter Property="Width" Value="180"/>
        <Setter Property="Height" Value="100"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:NodeControl}">

                    <Border
                    x:Name="PART_Border"
                    Background="Gray"
                    BorderBrush="Black"
                    BorderThickness="2"
                    CornerRadius="6">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Input ports -->
                            <ItemsControl
                            Grid.Column="0"
                            ItemsSource="{Binding Node.InputPorts, RelativeSource={RelativeSource TemplatedParent}}"
                            VerticalAlignment="Center"
                            Margin="-7,0,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Vertical"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type model:Port}">
                                        <local:PortControl
                                        Port="{Binding}"
                                        Margin="0,4"
                                        ToolTip="{Binding Name}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Title -->
                            <TextBlock
                            Grid.Column="1"
                            Text="{Binding Node.Title, RelativeSource={RelativeSource TemplatedParent}}"
                            Foreground="White"
                            FontSize="20"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                            <!-- Output ports -->
                            <ItemsControl
                            Grid.Column="2"
                            ItemsSource="{Binding Node.OutputPorts, RelativeSource={RelativeSource TemplatedParent}}"
                            VerticalAlignment="Center"
                            Margin="0,0,-7,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Vertical"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type model:Port}">
                                        <local:PortControl
                                        Port="{Binding}"
                                        Margin="0,4"
                                        ToolTip="{Binding Name}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </Grid>

                    </Border>

                    <ControlTemplate.Triggers>
                        <DataTrigger
                        Binding="{Binding Node.IsSelected, RelativeSource={RelativeSource TemplatedParent}}"
                        Value="True">
                            <Setter TargetName="PART_Border" Property="BorderBrush" Value="#FF00AEFF"/>
                            <Setter TargetName="PART_Border" Property="BorderThickness" Value="3"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>

                </ControlTemplate>
            </Setter.Value>
        </Setter>

    </Style>


    <!-- ============================================================
         NodeCanvas
         ============================================================ -->

    <Style TargetType="{x:Type local:NodeCanvas}">

        <!-- Canvas appearance -->

        <Setter Property="Background" Value="#202020"/>
        <Setter Property="ClipToBounds" Value="True"/>

        <!-- NodeCanvas template -->

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:NodeCanvas}">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        ClipToBounds="True">

                        <Canvas x:Name="PART_TransformRoot">
                            <Canvas.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="PART_ScaleTransform"/>
                                    <TranslateTransform x:Name="PART_PanTransform"/>
                                </TransformGroup>
                            </Canvas.RenderTransform>

                            <ItemsPresenter x:Name="PART_ItemsPresenter"/>

                            <Rectangle
                                x:Name="PART_SelectionBox"
                                Fill="#3300AEFF"
                                Stroke="#FF00AEFF"
                                StrokeThickness="1"
                                IsHitTestVisible="False"
                                Visibility="Collapsed"/>

                        </Canvas>
                    </Border>

                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <Canvas
                        Width="{Binding WorldWidth, RelativeSource={RelativeSource AncestorType={x:Type local:NodeCanvas}}}"
                        Height="{Binding WorldHeight, RelativeSource={RelativeSource AncestorType={x:Type local:NodeCanvas}}}"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>

        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate DataType="{x:Type model:Node}">
                    <local:NodeControl Node="{Binding}"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>

        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="{x:Type ContentPresenter}">
                    <Setter Property="Canvas.Left" Value="{Binding Position.X}"/>
                    <Setter Property="Canvas.Top" Value="{Binding Position.Y}"/>
                    <Setter Property="Panel.ZIndex" Value="{Binding ZIndex}"/>
                </Style>
            </Setter.Value>
        </Setter>

    </Style>

    <!-- PortControl -->
    <Style TargetType="{x:Type local:PortControl}">

        <Setter Property="Width" Value="14"/>
        <Setter Property="Height" Value="14"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:PortControl}">

                    <Ellipse
                    x:Name="PART_Dot"
                    Fill="#FFCCCCCC"
                    Stroke="Black"
                    StrokeThickness="1.5"/>

                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>

            <DataTrigger
            Binding="{Binding Port.Direction, RelativeSource={RelativeSource Self}}"
            Value="{x:Static model:PortDirection.Output}">
                <Setter Property="HorizontalAlignment" Value="Right"/>
            </DataTrigger>

            <DataTrigger
            Binding="{Binding Port.Direction, RelativeSource={RelativeSource Self}}"
            Value="{x:Static model:PortDirection.Input}">
                <Setter Property="HorizontalAlignment" Value="Left"/>
            </DataTrigger>

        </Style.Triggers>

    </Style>

</ResourceDictionary>
    
    