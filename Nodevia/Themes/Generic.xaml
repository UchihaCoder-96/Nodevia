<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Nodevia.Controls"
    xmlns:model="clr-namespace:Nodevia.Models"
    xmlns:editors="clr-namespace:Nodevia.Controls.ValueEditors">
    
    <!-- ============================================================
     NodeControl
     ============================================================ -->

    <Style TargetType="{x:Type local:NodeControl}">
        <Style.Resources>
            <DataTemplate x:Key="PortValueTemplate.float">
                <TextBox
    Width="50"
    Height="22"
    Margin="5,0,0,0"
    Padding="3,0"
    VerticalContentAlignment="Center"
    Text="{Binding DefaultValue,
        Mode=TwoWay,
        UpdateSourceTrigger=LostFocus}"/>
            </DataTemplate>

            <DataTemplate x:Key="PortValueTemplate.int">
                <TextBox
    Width="50"
    Height="22"
    Margin="5,0,0,0"
    Padding="3,0"
    VerticalContentAlignment="Center"
    Text="{Binding DefaultValue,
        Mode=TwoWay,
        UpdateSourceTrigger=LostFocus}"/>
            </DataTemplate>

            <DataTemplate x:Key="PortValueTemplate.bool">
                <CheckBox
    Margin="5,0,0,0"
    VerticalAlignment="Center"
    IsChecked="{Binding DefaultValue,
        Mode=TwoWay}"/>
            </DataTemplate>

            <DataTemplate x:Key="PortValueTemplate.Default">
                <TextBox
    Width="60"
    Height="22"
    Margin="5,0,0,0"
    Padding="3,0"
    VerticalContentAlignment="Center"
    Text="{Binding DefaultValue,
        Mode=TwoWay,
        UpdateSourceTrigger=LostFocus}"/>
            </DataTemplate>

            <DataTemplate x:Key="PortValueTemplate.string">
                <TextBox
    Width="60"
    Height="22"
    Margin="5,0,0,0"
    Padding="3,0"
    VerticalContentAlignment="Center"
    Text="{Binding DefaultValue,
        Mode=TwoWay,
        UpdateSourceTrigger=LostFocus}"/>
            </DataTemplate>

            <DataTemplate x:Key="PortValueTemplate.enum">
                <ComboBox
    Width="70"
    Height="22"
    Margin="5,0,0,0"
    VerticalContentAlignment="Center"
    ItemsSource="{Binding EnumValues}"
    SelectedItem="{Binding DefaultValue,
        Mode=TwoWay}"/>
            </DataTemplate>

            <!-- NoneValueEditor -->
            <Style TargetType="{x:Type editors:NoneValueEditor}">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type editors:NoneValueEditor}"/>
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate x:Key="PortValueTemplate.none">
                <editors:NoneValueEditor Port="{Binding}"/>
            </DataTemplate>

            <local:PortValueTemplateSelector x:Key="PortValueTemplateSelector"/>
        </Style.Resources>
        <Setter Property="Width" Value="220"/>
        <Setter Property="BorderBrush" Value="#FF333344"/>
        <Setter Property="BorderThickness" Value="1"/>

        <Setter Property="Template">
            <Setter.Value>

                <ControlTemplate TargetType="{x:Type local:NodeControl}">

                    <Border
                    x:Name="PART_Border"
                    Background="#FF181820"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="7">

                        <Grid>

                            <Grid.RowDefinitions>
                                <!-- Header -->
                                <RowDefinition Height="32"/>

                                <!-- Body -->
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- =================================================
                             HEADER
                             ================================================= -->

                            <Border
                            x:Name="PART_Header"
                            Grid.Row="0"
                            Background="#FF292938"
                            CornerRadius="6,6,0,0">

                                <TextBlock
                                Text="{Binding Node.Title,
                                    RelativeSource={RelativeSource TemplatedParent}}"
                                Foreground="#FFF0F0F5"
                                FontSize="14"
                                FontWeight="SemiBold"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Margin="8,0"/>

                            </Border>


                            <!-- =================================================
                             BODY
                             ================================================= -->

                            <Grid
                                Grid.Row="1"
                                Margin="0,4,0,6"
                                MinHeight="36">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>


                                <!-- =========================
                                 INPUT PORTS
                                 ========================= -->

                                <ItemsControl
                                Grid.Column="0"
                                ItemsSource="{Binding Node.InputPorts,
                                    RelativeSource={RelativeSource TemplatedParent}}"
                                VerticalAlignment="Center"
                                Margin="-7,0,0,0">

                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel
                                            Orientation="Vertical"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>

                                        <DataTemplate DataType="{x:Type model:Port}">

                                            <StackPanel
        Orientation="Horizontal"
        VerticalAlignment="Center"
        Margin="0,3">

                                                <!-- Socket -->
                                                <local:PortControl
            Port="{Binding}"
            ToolTip="{Binding Name}"/>

                                                <!-- Value editor -->
                                                <ContentControl
            Content="{Binding}"
            ContentTemplateSelector="{StaticResource PortValueTemplateSelector}"/>

                                                <!-- Name -->
                                                <TextBlock
            Text="{Binding Name}"
            Foreground="#FFD0D0D8"
            FontSize="11"
            VerticalAlignment="Center"
            Margin="5,0,0,0"/>

                                                <!-- Type -->
                                                <TextBlock
            Text="{Binding DataType,
                StringFormat='  ({0})'}"
            Foreground="#FF777783"
            FontSize="9"
            VerticalAlignment="Center"/>

                                            </StackPanel>

                                        </DataTemplate>

                                    </ItemsControl.ItemTemplate>

                                </ItemsControl>

                                <!-- =========================
                                 OUTPUT PORTS
                                 ========================= -->

                                <ItemsControl
                                Grid.Column="2"
                                ItemsSource="{Binding Node.OutputPorts,
                                    RelativeSource={RelativeSource TemplatedParent}}"
                                VerticalAlignment="Center"
                                Margin="0,0,-7,0">

                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel
                                            Orientation="Vertical"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>

                                        <DataTemplate
                                        DataType="{x:Type model:Port}">

                                            <StackPanel
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Margin="0,3">

                                                <TextBlock
                                                    Text="{Binding Name}"
                                                    Foreground="#FFD0D0D8"
                                                    FontSize="11"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Right"/>

                                                <TextBlock
                                                    Text="{Binding DataType,
                                                        StringFormat='  ({0})'}"
                                                    Foreground="#FF777783"
                                                    FontSize="9"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Right"/>

                                                <local:PortControl
                                                    Port="{Binding}"
                                                    ToolTip="{Binding Name}"/>

                                            </StackPanel>

                                        </DataTemplate>

                                    </ItemsControl.ItemTemplate>

                                </ItemsControl>

                            </Grid>

                        </Grid>

                    </Border>


                    <!-- =========================================================
                     SELECTION
                     ========================================================= -->

                    <ControlTemplate.Triggers>

                        <Trigger
                        Property="IsNodeSelected"
                        Value="True">

                            <Setter
                            TargetName="PART_Border"
                            Property="BorderBrush"
                            Value="#FF00AEFF"/>

                            <Setter
                            TargetName="PART_Border"
                            Property="BorderThickness"
                            Value="2"/>

                            <Setter
                            TargetName="PART_Border"
                            Property="Effect">

                                <Setter.Value>

                                    <DropShadowEffect
                                    Color="#9900AEFF"
                                    BlurRadius="16"
                                    ShadowDepth="0"
                                    Opacity="0.8"/>

                                </Setter.Value>

                            </Setter>

                            <Setter
                            TargetName="PART_Header"
                            Property="Background"
                            Value="#FF123A50"/>

                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Setter.Value>
        </Setter>

    </Style>


    <!-- ============================================================
         NodeCanvas
         ============================================================ -->

    <Style TargetType="{x:Type local:NodeCanvas}">

        <!-- Canvas appearance -->

        <Setter Property="Background" Value="#202020"/>
        <Setter Property="ClipToBounds" Value="True"/>

        <!-- NodeCanvas template -->

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:NodeCanvas}">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        ClipToBounds="True">

                        <Grid>
                            <local:BackgroundLayer
                                x:Name="PART_BackgroundLayer"
                                PanX="{Binding PanX, RelativeSource={RelativeSource TemplatedParent}}"
                                PanY="{Binding PanY, RelativeSource={RelativeSource TemplatedParent}}"
                                Zoom="{Binding Zoom, RelativeSource={RelativeSource TemplatedParent}}"/>

                            <Canvas x:Name="PART_TransformRoot">
                                <Canvas.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform x:Name="PART_ScaleTransform"/>
                                        <TranslateTransform x:Name="PART_PanTransform"/>
                                    </TransformGroup>
                                </Canvas.RenderTransform>

                                <local:ConnectionLayer x:Name="PART_ConnectionLayer" IsHitTestVisible="False"/>

                                <ItemsPresenter x:Name="PART_ItemsPresenter"/>

                                <Rectangle
                                    x:Name="PART_SelectionBox"
                                    Fill="#3300AEFF"
                                    Stroke="#FF00AEFF"
                                    StrokeThickness="1"
                                    IsHitTestVisible="False"
                                    Visibility="Collapsed"/>

                            </Canvas>
                        </Grid>
                    </Border>

                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <Canvas
                        Width="{Binding WorldWidth, RelativeSource={RelativeSource AncestorType={x:Type local:NodeCanvas}}}"
                        Height="{Binding WorldHeight, RelativeSource={RelativeSource AncestorType={x:Type local:NodeCanvas}}}"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>

        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate DataType="{x:Type model:Node}">
                    <local:NodeControl Node="{Binding}"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>

        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="{x:Type ContentPresenter}">
                    <Setter Property="Canvas.Left" Value="{Binding Position.X}"/>
                    <Setter Property="Canvas.Top" Value="{Binding Position.Y}"/>
                    <Setter Property="Panel.ZIndex" Value="{Binding ZIndex}"/>
                </Style>
            </Setter.Value>
        </Setter>

    </Style>

    <!-- PortControl -->
    <Style TargetType="{x:Type local:PortControl}">

        <Setter Property="Width" Value="14"/>
        <Setter Property="Height" Value="14"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:PortControl}">

                    <Ellipse
                    x:Name="PART_Dot"
                    Fill="#FFCCCCCC"
                    Stroke="Black"
                    StrokeThickness="1.5"/>

                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>

            <DataTrigger
            Binding="{Binding Port.Direction, RelativeSource={RelativeSource Self}}"
            Value="{x:Static model:PortDirection.Output}">
                <Setter Property="HorizontalAlignment" Value="Right"/>
            </DataTrigger>

            <DataTrigger
            Binding="{Binding Port.Direction, RelativeSource={RelativeSource Self}}"
            Value="{x:Static model:PortDirection.Input}">
                <Setter Property="HorizontalAlignment" Value="Left"/>
            </DataTrigger>

        </Style.Triggers>

    </Style>

</ResourceDictionary>
    
    